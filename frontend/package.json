{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run dev",
    "dev": "npm run prepare:dev-data && concurrently --kill-others-on-fail --names api,app --prefix-colors cyan,magenta \"npm run dev:api\" \"npm run dev:app\"",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:app": "ng serve --configuration development",
    "prepare:dev-data": "node scripts/prepare-dev-data.mjs",
    "build": "ng build",
    "typecheck": "tsc --noEmit --project tsconfig.app.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "^22.0.5",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.5",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "concurrently": "^9.2.1",
    "json-server": "^0.17.4",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
